    "commit.txt":   {"stems": ["commit", "commithash", "acceptedcommit"], "exts": [".txt", ".md", ""]}
  },
  "report_fields": {
    "STATUS":                 ["status"],
    "OWNER":                  ["owner", "owners", "owning agent", "owning agents"],
