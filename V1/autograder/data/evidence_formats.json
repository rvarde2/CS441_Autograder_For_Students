    "FILES CREATED":          ["files created", "created files", "new files", "files added", "added files"],
    "FILES MODIFIED":         ["files modified", "modified files", "files changed", "changed files", "files updated", "updated files"],
    "COMMANDS RUN":           ["commands run", "commands executed", "executed commands", "commands"],
    "TEST RESULTS":           ["test results", "tests run", "testing results"],
    "VALIDATION RESULTS":     ["validation results", "validation"],
    "ASSUMPTIONS":            ["assumptions"],
    "RISKS":                  ["risks"],
    "MANUAL ACTION REQUIRED": ["manual action required", "manual actions required", "manual action", "manual actions"],
    "BLOCKED-ON OWNER":       ["blocked on owner"],
